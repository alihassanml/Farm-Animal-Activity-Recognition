DATABASE_URL=sqlite:///./farm.db
# Required: long random string. Generate one with:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=change-me
JWT_EXPIRE_HOURS=24
# true when served over HTTPS
COOKIE_SECURE=false

# single = MODEL_PATH (3 classes: standing, lying, foraging) | dual = posture + state models
MODEL_MODE=single
MODEL_PATH=models/model.pt
POSTURE_MODEL_PATH=models/best_posture.pt
STATE_MODEL_PATH=models/best_state.pt
CONF_THRESHOLD=0.45
MERGE_IOU=0.5
INFERENCE_IMGSZ=640

# Cow tracking in videos and cameras (counted in sampled frames)
TRACK_IOU=0.3
TRACK_MAX_LOST=5
# label = majority over the last N frames per cow; 1 = off
SMOOTH_WINDOW=5

UPLOAD_DIR=uploads
MAX_UPLOAD_MB=200
VIDEO_SAMPLE_FPS=1
CAMERA_SAMPLE_SECONDS=1
ALERT_CHECK_SECONDS=60

# Live view: max video frame rate sent to the browser, and how often the model refreshes the
# boxes while someone watches (lower these on a slow computer)
STREAM_FPS=30
LIVE_DETECT_FPS=8
STREAM_MAX_WIDTH=960
STREAM_JPEG_QUALITY=75

FRONTEND_URL=http://localhost:5173

# DEBUG | INFO | WARNING | ERROR; logs go to the console and LOG_DIR/app.log (rotated)
LOG_LEVEL=INFO
LOG_DIR=logs
