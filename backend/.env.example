DATABASE_URL=sqlite:///./farm.db
# Required: long random string. Generate one with:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=change-me
JWT_EXPIRE_HOURS=24
# true when served over HTTPS
COOKIE_SECURE=false

# single = models/best.pt (5 classes) | dual = posture + state models
MODEL_MODE=single
MODEL_PATH=models/best.pt
POSTURE_MODEL_PATH=models/best_posture.pt
STATE_MODEL_PATH=models/best_state.pt
CONF_THRESHOLD=0.35
MERGE_IOU=0.5
INFERENCE_IMGSZ=640

UPLOAD_DIR=uploads
MAX_UPLOAD_MB=200
VIDEO_SAMPLE_FPS=1
CAMERA_SAMPLE_SECONDS=1
ALERT_CHECK_SECONDS=60

FRONTEND_URL=http://localhost:5173
