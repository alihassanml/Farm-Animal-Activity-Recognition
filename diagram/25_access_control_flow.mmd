flowchart TD
    A["API request"] --> B{"Login cookie present?"}
    B -- "No" --> E1["401 Not logged in"]
    B -- "Yes" --> C{"JWT valid and<br/>user exists?"}
    C -- "No" --> E2["401 Session expired"]
    C -- "Yes" --> D{"User is a member of<br/>the workspace?"}
    D -- "No" --> E3["404 Not found"]
    D -- "Yes" --> F{"Admin-only route?"}
    F -- "No" --> OK["Run request handler"]
    F -- "Yes" --> G{"Role is admin?"}
    G -- "No" --> E4["403 Forbidden"]
    G -- "Yes" --> OK

    classDef bad fill:#FDECEC,stroke:#C62828,color:#1A1D1B
    classDef good fill:#1F6F4A,stroke:#1F6F4A,color:#FFFFFF
    class E1,E2,E3,E4 bad
    class OK good
